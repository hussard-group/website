---
import Cta from '../components/Cta.astro';
import Hero from '../components/Hero.astro';
import Scene from '../components/Scene.astro';
import Zoom from '../components/Zoom.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <Hero />
    <Scene
        text="For 300,000 years, being human meant a single thing: to *evolve. We made fire. We forged tools. We crossed oceans on wood and instinct. We split the atom. We left the planet. Adaptation was never a choice. It was our *nature."
    />
    <Zoom word="HUSSARD" />
    <Cta />
</Layout>
