---
import { buttonClass } from '@sinstry-research/design/button/recipe';
import { EMAIL } from '../lib/site';
---

<section class="website-section website-cta-section" data-theme="light">
    <div class="website-container website-cta-center">
        <header class="website-section-header fade">
            <h2 class="typo-h3">Which species are you?</h2>
        </header>
        <div class="website-cta-buttons fade" style="transition-delay: 150ms">
            <a class={buttonClass({ variant: 'accent' })} href={`mailto:${EMAIL}`}>
                Join Us
            </a>
        </div>
    </div>
</section>
