---
import { EMAIL } from '../lib/site';
---

<section class="cta">
    <div class="container">
        <div class="reveal">
            <h2 class="cta-title">
                What sets humans apart from animals is the ability to adapt and to learn rapidly,
                iteratively.
            </h2>
        </div>
        <div class="reveal" style="transition-delay: 150ms">
            <a class="cta-button button btn-variant--accent button--radius-full control--lg" href={`mailto:${EMAIL}`}> Which species are you? </a>
        </div>
    </div>
</section>
