---
import '../styles/main.css';
import { NeutralTriplet } from '@sinstry-research/design/tokens';
import { oklchToHex } from '@sinstry-research/design/utils/color';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { canonical } from '../lib/site';

export interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'Hussard',
    description = 'Hussard - A development group for a species that refuses to stop evolving.',
} = Astro.props;

const canonicalUrl = canonical(Astro.url.pathname);
const neutral = NeutralTriplet('50');
const themeColor = oklchToHex(neutral.l, neutral.c, neutral.h);
---

<!DOCTYPE html>
<html lang="en" data-context="website" data-theme="light">
    <head>
        <!-- First evaluated style: pins cascade layer precedence before any
             dev-injected <style> tag (see design styles/base/index.css). -->
        <style is:inline>
        @layer base, layout, components, utilities, overrides;
        </style>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content={description}>
        <meta name="theme-color" content={themeColor}>
        <meta name="color-scheme" content="light dark">
        <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
        <title>{title}</title>
        <link rel="canonical" href={canonicalUrl}>

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Hussard">
        <meta property="og:title" content={title}>
        <meta property="og:description" content={description}>
        <meta property="og:url" content={canonicalUrl}>
        <meta property="og:image" content="https://hussard.group/assets/rocket.jpg">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content={description}>
        <meta name="twitter:image" content="https://hussard.group/assets/rocket.jpg">

        <script
            type="application/ld+json"
            set:html={`{
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "Hussard Group",
          "url": "https://hussard.group/",
          "email": "hussard.group@proton.me",
          "description": "A development group for a species that refuses to stop evolving."
        },
        {
          "@type": "WebSite",
          "name": "Hussard",
          "url": "https://hussard.group/",
          "inLanguage": "en"
        }
      ]
    }`}
        />
        <script is:inline>
        document.documentElement.classList.add('js');
        </script>
    </head>
    <body>
        <Navbar />
        <main class="website-layout__main">
            <slot />
        </main>
        <Footer />

        <script>
        import { reveal } from '../lib/reveal';
        import { bindScrub, bindZoom } from '../lib/scrub';

        reveal(document.querySelectorAll('.fade'));
        bindScrub(document.querySelectorAll('.scrub'));
        bindZoom(document.querySelectorAll('.zoom'));
        </script>
    </body>
</html>
